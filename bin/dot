#!/usr/bin/env bash
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH="$dotfilesDirectory"

if [ -z "${DOTFILES_PROFILE:-}" ]; then
	case "$(uname -s)" in
		Darwin) DOTFILES_PROFILE=macos ;;
		Linux) DOTFILES_PROFILE=omarchy ;;
		*) echo "Unsupported operating system: $(uname -s)"; exit 1 ;;
	esac
fi
export DOTFILES_PROFILE

# Update dotfiles themselves
if [ -n "$(git -C "$ZSH" status --porcelain --untracked-files=normal)" ]; then
	echo "› Skipping git pull: dotfiles have uncommitted changes; continuing local setup"
else
	echo "› git pull"
	git -C "$ZSH" pull --ff-only
fi

case "$DOTFILES_PROFILE" in
	macos)
		# Apply macOS preferences and keep Homebrew current.
		"$ZSH/platform/macos/system/set-defaults.sh"
		"$ZSH/platform/macos/system/set-hostname.sh"
		"$ZSH/platform/macos/homebrew/install.sh" 2>&1

		echo "› brew update"
		brew update

		echo "› brew upgrade"
		brew upgrade --no-ask
		;;
	omarchy)
		# Omarchy owns the base operating-system setup. Package installation is
		# intentionally handled by the narrower platform installer below.
		;;
	*)
		echo "Unknown dotfiles profile: $DOTFILES_PROFILE"
		exit 1
		;;
esac

# Install software
echo "› script/install"
"$ZSH/script/install"
