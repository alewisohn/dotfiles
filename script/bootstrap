#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e
set -o pipefail

install_dependencies=true
while [ "$#" -gt 0 ]
do
  case "$1" in
    --skip-packages)
      install_dependencies=false
      ;;
    -h|--help)
      echo "usage: script/bootstrap [--skip-packages]"
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit 1
}

detect_profile () {
  if [ -n "${DOTFILES_PROFILE:-}" ]; then
    printf '%s\n' "$DOTFILES_PROFILE"
    return
  fi

  case "$(uname -s)" in
    Darwin) printf '%s\n' 'macos' ;;
    Linux)  printf '%s\n' 'omarchy' ;;
    *)      fail "unsupported operating system: $(uname -s)" ;;
  esac
}

DOTFILES_PROFILE=$(detect_profile)
export DOTFILES_PROFILE

if [ ! -d "$DOTFILES_ROOT/platform/$DOTFILES_PROFILE" ]; then
  fail "unknown dotfiles profile: $DOTFILES_PROFILE"
fi

setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}


link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -L "$dst" ] && [ "$(readlink "$dst")" == "$src" ]; then
    success "skipped $src"
    return
  fi

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      while true
      do
        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        if ! read -r -n 1 action; then
          fail "could not read a choice for $dst"
        fi
        echo ''

        case "$action" in
          o )
            overwrite=true; break;;
          O )
            overwrite_all=true; break;;
          b )
            backup=true; break;;
          B )
            backup_all=true; break;;
          s )
            skip=true; break;;
          S )
            skip_all=true; break;;
          * )
            user 'Please choose s, S, o, O, b, or B.';;
        esac
      done

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info "installing dotfiles for $DOTFILES_PROFILE"

  local overwrite_all=false backup_all=false skip_all=false

  # The zsh entry point moved from the shared tree into the macOS profile.
  if [ -L "$HOME/.zshrc" ] && \
    [ "$(readlink "$HOME/.zshrc")" = "$DOTFILES_ROOT/zsh/zshrc.symlink" ]; then
    rm "$HOME/.zshrc"
    success "removed legacy link $HOME/.zshrc"
  fi

  # Remove links created by the previous, non-profile-aware layout. Only links
  # that still point at the exact legacy locations are touched.
  local legacy_relative legacy_src legacy_dst
  for legacy_relative in \
    aerospace/aerospace.toml.symlink \
    borders/bordersrc.symlink \
    karabiner
  do
    legacy_src="$DOTFILES_ROOT/config/$legacy_relative"
    legacy_dst="$HOME/.config/${legacy_relative%.symlink}"
    if [ -L "$legacy_dst" ] && [ "$(readlink "$legacy_dst")" = "$legacy_src" ]; then
      rm "$legacy_dst"
      success "removed legacy link $legacy_dst"
    fi
  done

  # Keep file discovery on a separate descriptor so prompts read user input.
  while IFS= read -r -d '' -u 3 src
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done 3< <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*.git*' -print0)

  local platform_home="$DOTFILES_ROOT/platform/$DOTFILES_PROFILE/home"
  if [ -d "$platform_home" ]; then
    while IFS= read -r -d '' -u 3 src
    do
      dst="$HOME/.$(basename "${src%.*}")"
      link_file "$src" "$dst"
    done 3< <(find -H "$platform_home" -type f -name '*.symlink' -print0)
  fi

  local config_root relative_path
  for config_root in \
    "$DOTFILES_ROOT/config" \
    "$DOTFILES_ROOT/platform/$DOTFILES_PROFILE/config"
  do
    [ -d "$config_root" ] || continue

    # Karabiner watches its parent directory, so link that directory as a unit.
    if [ -d "$config_root/karabiner" ]; then
      mkdir -p "$HOME/.config"
      link_file "$config_root/karabiner" "$HOME/.config/karabiner"
    fi

    while IFS= read -r -d '' -u 3 src
    do
      relative_path="${src#"$config_root/"}"
      relative_path="${relative_path%.symlink}"
      dst="$HOME/.config/$relative_path"

      mkdir -p "$(dirname "$dst")"
      link_file "$src" "$dst"
    done 3< <(find -H "$config_root" \
      -path "$config_root/karabiner" -prune -o \
      -type f -not -path '*.git*' -print0)
  done
}

setup_gitconfig
install_dotfiles

# Install dependencies using the selected platform profile unless the caller
# only wants to refresh symlinks.
if [ "$install_dependencies" = true ]; then
  info "installing dependencies"
  if bash bin/dot | while read -r data; do info "$data"; done
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

echo ''
echo '  All installed!'
