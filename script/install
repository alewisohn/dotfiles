#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..
DOTFILES_ROOT=$(pwd -P)

if [ -z "${DOTFILES_PROFILE:-}" ]; then
  case "$(uname -s)" in
    Darwin) DOTFILES_PROFILE=macos ;;
    Linux) DOTFILES_PROFILE=omarchy ;;
    *) echo "Unsupported operating system: $(uname -s)"; exit 1 ;;
  esac
fi

case "$DOTFILES_PROFILE" in
  macos)
    echo "› brew bundle"
    brew bundle --file="$DOTFILES_ROOT/platform/macos/Brewfile"
    ;;
  omarchy)
    "$DOTFILES_ROOT/platform/omarchy/install.sh"
    ;;
  *)
    echo "Unknown dotfiles profile: $DOTFILES_PROFILE"
    exit 1
    ;;
esac
